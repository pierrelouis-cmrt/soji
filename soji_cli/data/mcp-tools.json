  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Your answer to Sōji. Call once with everything you found; Sōji verifies, measures and guards every item itself. Disk runs send findings, process runs send processVerdicts.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "cleanCommand": {
                "description": "The tool's official clean command, argv",
                "items": {
                  "maxLength": 300,
                  "type": "string"
                },
                "maxItems": 20,
                "type": "array"
              },
              "comesBack": {
                "description": "rebuilds: made again offline; downloads: fetched again; gone: lost",
                "enum": [
                  "rebuilds",
                  "downloads",
                  "gone"
                ],
                "type": "string"
              },
              "confidence": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "gitState": {
                "description": "What git_status showed; shown to the user, never used to tick",
                "enum": [
                  "clean-merged",
                  "dirty",
                  "unmerged"
                ],
                "type": "string"
              },
              "group": {
                "maxLength": 80,
                "type": "string"
              },
              "howItComesBack": {
                "maxLength": 500,
                "type": "string"
              },
              "inUseEvidence": {
                "maxLength": 500,
                "type": "string"
              },
              "lastUsed": {
                "description": "When it was last used (YYYY-MM-DD)",
                "maxLength": 40,
                "type": "string"
              },
              "levels": {
                "additionalProperties": false,
                "description": "Which level takes it, by idle time. {} with a reason: never",
                "properties": {
                  "aggressive": {
                    "description": "Idle hours before this level takes it; 0 is now. Leave out: this level doesn't take it",
                    "maximum": 8784,
                    "minimum": 0,
                    "type": "number"
                  },
                  "balanced": {
                    "description": "Idle hours before this level takes it; 0 is now. Leave out: this level doesn't take it",
                    "maximum": 8784,
                    "minimum": 0,
                    "type": "number"
                  },
                  "careful": {
                    "description": "Idle hours before this level takes it; 0 is now. Leave out: this level doesn't take it",
                    "maximum": 8784,
                    "minimum": 0,
                    "type": "number"
                  },
                  "reason": {
                    "maxLength": 200,
                    "type": "string"
                  }
                },
                "required": [
                  "reason"
                ],
                "type": "object"
              },
              "minLevel": {
                "description": "The least aggressive cleanup level at which you'd clean it",
                "enum": [
                  "careful",
                  "balanced",
                  "aggressive"
                ],
                "type": "string"
              },
              "path": {
                "description": "Absolute path of the folder or file",
                "type": "string"
              },
              "projectExists": {
                "description": "Whether the project it belongs to still exists",
                "type": "boolean"
              },
              "recommendation": {
                "enum": [
                  "remove",
                  "trash",
                  "keep",
                  "review"
                ],
                "type": "string"
              },
              "regenerable": {
                "description": "It comes back on its own if removed",
                "type": "boolean"
              },
              "title": {
                "maxLength": 200,
                "type": "string"
              },
              "whatItIs": {
                "maxLength": 200,
                "type": "string"
              },
              "whySafe": {
                "maxLength": 200,
                "type": "string"
              }
            },
            "required": [
              "path",
              "title",
              "group",
              "regenerable",
              "recommendation",
              "confidence"
            ],
            "type": "object"
          },
          "maxItems": 500,
          "type": "array"
        },
        "processVerdicts": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "command": {
                "maxLength": 4096,
                "type": "string"
              },
              "confidence": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "executablePath": {
                "maxLength": 4096,
                "type": "string"
              },
              "explanation": {
                "maxLength": 200,
                "type": "string"
              },
              "pid": {
                "minimum": 1,
                "type": "integer"
              },
              "reason": {
                "maxLength": 500,
                "type": "string"
              },
              "suggestion": {
                "enum": [
                  "quit",
                  "leave",
                  "never"
                ],
                "type": "string"
              }
            },
            "required": [
              "pid",
              "explanation",
              "suggestion",
              "reason",
              "confidence"
            ],
            "type": "object"
          },
          "maxItems": 200,
          "type": "array"
        }
      },
      "type": "object"
    },
    "name": "submit_findings",
    "title": "Submit findings"
  }
]