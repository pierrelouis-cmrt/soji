    "modelArguments": ["--model", "{model}"],
    "mcpAttach": "flag",
    "mcpFile": "soji-mcp.json",
    "mcpFormat": "mcpServers",
    "mcpServerExtra": {"type": "local", "tools": ["*"]},
    "readOnlyArguments": ["--allow-tool", "soji", "--deny-tool", "shell", "--deny-tool", "write"],
