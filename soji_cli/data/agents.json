[
  {
    "id": "claude",
    "name": "Claude Code",
    "verified": true,
    "docsUrl": "https://code.claude.com/docs/en/cli-reference",
    "helpAnchor": "claude",
    "binaries": ["claude"],
    "searchPaths": ["~/.local/bin", "~/.claude/local", "/opt/homebrew/bin", "/usr/local/bin", "~/.npm-global/bin", "~/.bun/bin"],
    "desktopApps": ["com.anthropic.claudefordesktop"],
    "versionArguments": ["--version"],
    "runArguments": [
      "-p",
      "--output-format",
      "json",
      "--mcp-config",
      "{mcp_config}",
      "--strict-mcp-config",
      "--no-session-persistence",
      "{flags}"
    ],
    "readOnlyArguments": [
      "--permission-mode",
      "dontAsk",
      "--allowedTools",
      "mcp__soji__*",
      "Read",
      "Glob",
      "Grep",
      "--disallowedTools",
      "Bash",
      "Edit",
      "Write",
      "NotebookEdit",
      "Task",
      "Agent"
    ],
    "modelArguments": ["--model", "{model}"],
    "effortArguments": ["--effort", "{effort}"],
    "maxTurnsArguments": ["--max-turns", "{max_turns}"],
    "chatArguments": ["{prompt}", "--mcp-config", "{mcp_config}", "{flags}"],
    "resumeArguments": ["--resume", "{session_id}", "{prompt}", "--mcp-config", "{mcp_config}", "{flags}"],
    "environment": {"CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"},
    "mcpAttach": "flag",
    "mcpFormat": "mcpServers",
    "mcpConfigFile": "soji-mcp.json",
    "writablePaths": [
      "~/.claude",
      "~/.claude.json*",
      "$CLAUDE_CONFIG_DIR",
      "$CLAUDE_CONFIG_DIR.json*",
      "~/.local/share/claude",
      "~/.local/state/claude",
      "~/.cache/claude*",
      "~/Library/Caches/claude-cli-nodejs",
      "/private/tmp/claude-*"
    ]
  },
  {
    "id": "codex",
    "name": "Codex",
    "verified": true,
    "docsUrl": "https://developers.openai.com/codex/cli/reference",
    "helpAnchor": "codex",
    "binaries": ["codex"],
    "searchPaths": [
      "/opt/homebrew/bin",
      "/usr/local/bin",
      "~/.local/bin",
      "~/.npm-global/bin",
      "~/.bun/bin",
      "/Applications/Codex.app/Contents/Resources",
      "~/.t3/tools/codex/*/bin"
    ],
    "desktopApps": ["com.openai.chat", "com.openai.codex"],
    "versionArguments": ["--version"],
    "runArguments": [
      "exec",
      "--skip-git-repo-check",
      "--ephemeral",
      "--ignore-user-config",
      "--color",
      "never",
      "--json",
      "{mcp_inline}",
      "{flags}",
      "-"
    ],
    "readOnlyArguments": ["--sandbox", "read-only"],
    "modelArguments": ["--model", "{model}"],
    "effortArguments": ["-c", "model_reasoning_effort=\"{effort}\""],
    "chatArguments": ["{mcp_inline}", "{flags}", "{prompt}"],
    "resumeArguments": ["resume", "{session_id}", "{mcp_inline}", "{flags}", "{prompt}"],
    "mcpAttach": "inlineConfig",
    "mcpFormat": "codexInline",
    "mcpServerFields": {"default_tools_approval_mode": "approve"},
    "writablePaths": ["~/.codex", "$CODEX_HOME"]
  },
  {
    "id": "cursor",
    "name": "Cursor CLI",
    "verified": false,
    "docsUrl": "https://cursor.com/docs/cli/reference/parameters",
    "helpAnchor": "cursor",
    "binaries": ["cursor-agent"],
    "searchPaths": ["~/.local/bin", "/opt/homebrew/bin", "/usr/local/bin"],
    "desktopApps": ["com.todesktop.230313mzl4w4u92"],
    "versionArguments": ["--version"],
    "runArguments": ["--print", "--output-format", "text", "--trust", "--approve-mcps", "{flags}", "{prompt}"],
    "readOnlyArguments": ["--mode", "ask"],
    "modelArguments": ["--model", "{model}"],
    "chatArguments": ["{flags}", "{prompt}"],
    "resumeArguments": ["--resume", "{session_id}", "{flags}", "{prompt}"],
    "mcpAttach": "configFile",
    "mcpFormat": "mcpServers",
    "mcpConfigFile": ".cursor/mcp.json",
    "writablePaths": ["~/.cursor", "~/.config/cursor", "~/.local/share/cursor-agent", "~/Library/Application Support/cursor-agent"]
  },
  {
    "id": "grok",
    "name": "Grok CLI",
    "verified": true,
    "docsUrl": "https://docs.x.ai/grok-build",
    "helpAnchor": "grok",
    "binaries": ["grok"],
    "searchPaths": ["~/.grok/bin", "~/.local/bin", "/opt/homebrew/bin", "/usr/local/bin"],
    "versionArguments": ["--version"],
    "runArguments": ["--prompt-file", "{prompt_file}", "--output-format", "plain", "--no-subagents", "--no-auto-update", "{flags}"],
    "readOnlyArguments": [
      "--permission-mode",
      "dontAsk",
      "--allow",
      "mcp__soji__*",
      "--disallowed-tools",
      "run_terminal_cmd,write,search_replace,task"
    ],
    "modelArguments": ["--model", "{model}"],
    "effortArguments": ["--reasoning-effort", "{effort}"],
    "maxTurnsArguments": ["--max-turns", "{max_turns}"],
    "chatArguments": ["{flags}", "{prompt}"],
    "resumeArguments": ["--resume", "{session_id}", "{flags}", "{prompt}"],
    "environment": {"GROK_FOLDER_TRUST": "0"},
    "mcpAttach": "configFile",
    "mcpFormat": "toml",
    "mcpConfigFile": ".grok/config.toml",
    "writablePaths": ["~/.grok", "$GROK_HOME"]
  },
  {
    "id": "antigravity",
    "name": "Antigravity CLI",
    "verified": false,
    "docsUrl": "https://antigravity.google/docs",
    "helpAnchor": "gemini",
    "binaries": ["agy", "antigravity"],
    "searchPaths": ["~/.local/bin", "/opt/homebrew/bin", "/usr/local/bin"],
    "versionArguments": ["--version"],
    "runArguments": ["--output-format", "text", "{flags}", "--prompt", "{prompt}"],
    "readOnlyArguments": ["--mode", "plan"],
    "modelArguments": ["--model", "{model}"],
    "mcpAttach": "configFile",
    "mcpFormat": "mcpServers",
    "mcpConfigFile": ".agents/mcp_config.json",
    "writablePaths": ["~/.gemini"]
  },
  {
    "id": "copilot",
    "name": "GitHub Copilot CLI",
    "verified": false,
    "docsUrl": "https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-programmatic-reference",
    "helpAnchor": "copilot",
    "binaries": ["copilot"],
    "searchPaths": ["/opt/homebrew/bin", "/usr/local/bin", "~/.npm-global/bin", "~/.bun/bin", "~/.local/bin"],
    "versionArguments": ["--version"],
    "runArguments": ["--silent", "--no-ask-user", "--additional-mcp-config", "@{mcp_config}", "{flags}", "--prompt", "{prompt}"],
    "readOnlyArguments": ["--allow-tool", "soji", "--deny-tool", "shell", "--deny-tool", "write"],
    "modelArguments": ["--model", "{model}"],
    "mcpAttach": "flag",
    "mcpFormat": "mcpServers",
    "mcpConfigFile": "soji-mcp.json",
    "mcpServerFields": {"type": "local", "tools": ["*"]},
    "writablePaths": ["~/.copilot", "$COPILOT_HOME", "~/.config/github-copilot"]
  },
  {
    "id": "kimi",
    "name": "Kimi CLI",
    "verified": false,
    "docsUrl": "https://moonshotai.github.io/kimi-code/en/reference/kimi-command",
    "helpAnchor": "kimi",
    "binaries": ["kimi"],
    "searchPaths": ["~/.local/bin", "/opt/homebrew/bin", "/usr/local/bin", "~/.npm-global/bin"],
    "versionArguments": ["--version"],
    "runArguments": ["--output-format", "text", "{flags}", "--prompt", "{prompt}"],
    "readOnlyArguments": [],
    "modelArguments": ["--model", "{model}"],
    "mcpAttach": "configFile",
    "mcpFormat": "mcpServers",
    "mcpConfigFile": ".kimi-code/mcp.json",
    "writablePaths": ["~/.kimi-code", "~/.kimi", "$KIMI_CODE_HOME"]
  },
  {
    "id": "gemini",
    "name": "Gemini CLI",
    "showInPicker": false,
    "verified": false,
    "docsUrl": "https://github.com/google-gemini/gemini-cli/blob/main/docs/cli/headless.md",
    "helpAnchor": "gemini",
    "binaries": ["gemini"],
    "searchPaths": ["/opt/homebrew/bin", "/usr/local/bin", "~/.npm-global/bin", "~/.bun/bin", "~/.local/bin"],
    "versionArguments": ["--version"],
    "runArguments": ["--output-format", "text", "--allowed-mcp-server-names", "soji", "{flags}", "--prompt", "{prompt}"],
    "readOnlyArguments": ["--approval-mode", "default"],
    "modelArguments": ["--model", "{model}"],
    "mcpAttach": "configFile",
    "mcpFormat": "mcpServers",
    "mcpConfigFile": ".gemini/settings.json",
    "mcpServerFields": {"trust": true},
    "mcpConfigFields": {"tools": {"exclude": ["run_shell_command", "write_file", "replace"]}},
    "writablePaths": ["~/.gemini"]
  },
  {
    "id": "opencode",
    "name": "opencode",
    "showInPicker": false,
    "verified": false,
    "docsUrl": "https://opencode.ai/docs/cli/",
    "helpAnchor": "opencode",
    "binaries": ["opencode"],
    "searchPaths": ["~/.opencode/bin", "/opt/homebrew/bin", "/usr/local/bin", "~/.npm-global/bin", "~/.bun/bin", "~/.local/bin"],
    "versionArguments": ["--version"],
    "runArguments": ["run", "{flags}", "{prompt}"],
    "readOnlyArguments": [],
    "modelArguments": ["--model", "{model}"],
    "environment": {"OPENCODE_CONFIG": "{mcp_config}"},
    "mcpAttach": "configFile",
    "mcpFormat": "opencode",
    "mcpConfigFile": "opencode.json",
    "mcpConfigFields": {"permission": {"edit": "deny", "bash": "deny", "webfetch": "allow"}},
    "writablePaths": ["~/.local/share/opencode", "~/.local/state/opencode", "~/.cache/opencode", "~/.config/opencode"]
  },
  {
    "id": "qwen",
    "name": "Qwen Code",
    "showInPicker": false,
    "verified": false,
    "docsUrl": "https://qwenlm.github.io/qwen-code-docs/en/users/features/headless/",
    "helpAnchor": "qwen",
    "binaries": ["qwen"],
    "searchPaths": ["/opt/homebrew/bin", "/usr/local/bin", "~/.npm-global/bin", "~/.bun/bin", "~/.local/bin"],
    "versionArguments": ["--version"],
    "runArguments": ["--output-format", "text", "{flags}", "--prompt", "{prompt}"],
    "readOnlyArguments": ["--approval-mode", "default"],
    "modelArguments": ["--model", "{model}"],
    "maxTurnsArguments": ["--max-session-turns", "{max_turns}"],
    "mcpAttach": "configFile",
    "mcpFormat": "mcpServers",
    "mcpConfigFile": ".qwen/settings.json",
    "mcpServerFields": {"trust": true},
    "mcpConfigFields": {"tools": {"exclude": ["run_shell_command", "write_file", "replace"]}},
    "writablePaths": ["~/.qwen"]
  },
  {
    "id": "custom",
    "name": "Custom command",
    "verified": false,
    "helpAnchor": "other",
    "binaries": [],
    "searchPaths": [],
    "runArguments": [],
    "readOnlyArguments": [],
    "mcpAttach": "flag",
    "mcpFormat": "mcpServers",
    "mcpConfigFile": "soji-mcp.json",
    "writablePaths": []
  }
]
