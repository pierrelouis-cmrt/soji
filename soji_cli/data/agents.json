[
  {
    "id": "claude",
    "name": "Claude Code",
    "binaries": ["claude"],
    "searchPaths": ["~/.local/bin", "~/.claude/local", "/opt/homebrew/bin", "/usr/local/bin", "~/.npm-global/bin", "~/.bun/bin"],
    "arguments": ["-p", "--output-format", "json", "--mcp-config", "{mcp_config}", "--strict-mcp-config", "--no-session-persistence", "{flags}"],
    "modelArguments": ["--model", "{model}"],
    "effortArguments": ["--effort", "{effort}"],
    "maxTurnsArguments": ["--max-turns", "{max_turns}"],
    "mcpAttach": "flag",
    "mcpFile": "soji-mcp.json",
    "mcpFormat": "mcpServers",
    "environment": {"CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"},
    "readOnlyArguments": ["--permission-mode", "dontAsk", "--allowedTools", "mcp__soji__*", "Read", "Glob", "Grep", "--disallowedTools", "Bash", "Edit", "Write", "NotebookEdit", "Task", "Agent"],
    "writablePaths": ["~/.claude", "~/.claude.json*", "$CLAUDE_CONFIG_DIR", "$CLAUDE_CONFIG_DIR.json*", "~/.local/share/claude", "~/.local/state/claude", "~/.cache/claude*", "~/Library/Caches/claude-cli-nodejs", "/private/tmp/claude-*"],
    "versionArguments": ["--version"],
    "chatArguments": ["{prompt}", "--mcp-config", "{mcp_config}", "{flags}"],
    "resumeArguments": ["--resume", "{session_id}", "{prompt}", "--mcp-config", "{mcp_config}", "{flags}"],
    "docs": "https://code.claude.com/docs/en/cli-reference",
    "helpAnchor": "claude",
    "desktopApps": ["com.anthropic.claudefordesktop"],
    "verified": true
  },
  {
    "id": "codex",
    "name": "Codex",
    "binaries": ["codex"],
    "searchPaths": ["/opt/homebrew/bin", "/usr/local/bin", "~/.local/bin", "~/.npm-global/bin", "~/.bun/bin", "/Applications/Codex.app/Contents/Resources", "~/.t3/tools/codex/*/bin"],
    "arguments": ["exec", "--skip-git-repo-check", "--ephemeral", "--ignore-user-config", "--color", "never", "--json", "{mcp_inline}", "{flags}", "-"],
    "modelArguments": ["--model", "{model}"],
    "effortArguments": ["-c", "model_reasoning_effort=\"{effort}\""],
    "mcpAttach": "inlineConfig",
    "mcpFormat": "codexInline",
    "mcpServerExtra": {"default_tools_approval_mode": "approve"},
    "readOnlyArguments": ["--sandbox", "read-only"],
    "writablePaths": ["~/.codex", "$CODEX_HOME"],
    "versionArguments": ["--version"],
    "chatArguments": ["{mcp_inline}", "{flags}", "{prompt}"],
    "resumeArguments": ["resume", "{session_id}", "{mcp_inline}", "{flags}", "{prompt}"],
    "docs": "https://developers.openai.com/codex/cli/reference",
    "helpAnchor": "codex",
    "desktopApps": ["com.openai.chat", "com.openai.codex"],
    "verified": true
  },
  {
    "id": "cursor",
    "name": "Cursor CLI",
    "binaries": ["cursor-agent"],
    "searchPaths": ["~/.local/bin", "/opt/homebrew/bin", "/usr/local/bin"],
    "arguments": ["--print", "--output-format", "text", "--trust", "--approve-mcps", "{flags}", "{prompt}"],
    "modelArguments": ["--model", "{model}"],
    "mcpAttach": "configFile",
    "mcpFile": ".cursor/mcp.json",
    "mcpFormat": "mcpServers",
    "readOnlyArguments": ["--mode", "ask"],
    "writablePaths": ["~/.cursor", "~/.config/cursor", "~/.local/share/cursor-agent", "~/Library/Application Support/cursor-agent"],
    "versionArguments": ["--version"],
    "chatArguments": ["{flags}", "{prompt}"],
    "resumeArguments": ["--resume", "{session_id}", "{flags}", "{prompt}"],
    "docs": "https://cursor.com/docs/cli/reference/parameters",
    "helpAnchor": "cursor",
    "desktopApps": ["com.todesktop.230313mzl4w4u92"],
    "verified": false
  },
  {
    "id": "grok",
    "name": "Grok CLI",
    "binaries": ["grok"],
    "searchPaths": ["~/.grok/bin", "~/.local/bin", "/opt/homebrew/bin", "/usr/local/bin"],
    "arguments": ["--prompt-file", "{prompt_file}", "--output-format", "plain", "--no-subagents", "--no-auto-update", "{flags}"],
    "modelArguments": ["--model", "{model}"],
    "effortArguments": ["--reasoning-effort", "{effort}"],
    "maxTurnsArguments": ["--max-turns", "{max_turns}"],
    "mcpAttach": "configFile",
    "mcpFile": ".grok/config.toml",
    "mcpFormat": "toml",
    "readOnlyArguments": ["--permission-mode", "dontAsk", "--allow", "mcp__soji__*", "--disallowed-tools", "run_terminal_cmd,write,search_replace,task"],
    "writablePaths": ["~/.grok", "$GROK_HOME"],
    "environment": {"GROK_FOLDER_TRUST": "0"},
    "versionArguments": ["--version"],
    "chatArguments": ["{flags}", "{prompt}"],
    "resumeArguments": ["--resume", "{session_id}", "{flags}", "{prompt}"],
    "docs": "https://docs.x.ai/grok-build",
    "helpAnchor": "grok",
    "verified": true
  },
  {
